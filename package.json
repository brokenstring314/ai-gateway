{
  "name": "ai-gateway-rewrite",
  "version": "0.2.0",
  "license": "Apache-2.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "test": "bun test",
    "test:e2e": "bun test --timeout 30000 ./tests/e2e/*.e2e.ts",
    "test:watch": "bun test --watch",
    "typecheck": "tsc --noEmit",
    "lint": "biome ci .",
    "typecheck:tests": "tsc --noEmit -p tsconfig.test.json",
    "lint:fix": "biome lint --write .",
    "console:build": "bun --bun vite build --config console/vite.config.ts --logLevel warn && bun scripts/embed-console.ts",
    "console:dev": "bun --bun vite --config console/vite.config.ts",
    "console:typecheck": "tsc --noEmit -p console/tsconfig.json && tsc --noEmit -p tests/console/tsconfig.json"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@preact/preset-vite": "^2.10.6",
    "@types/bun": "1.3.14",
    "@types/node": "^26.1.1",
    "happy-dom": "^21.0.4",
    "openai": "7.38.0",
    "preact": "10",
    "typescript": "7.0.2",
    "vite": "7"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/core": "^2.10.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "dotenv": "^17.4.2",
    "hono": "^4.13.7",
    "prom-client": "^15.1.3",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "engines": {
    "bun": ">=1.4.3"
  }
}
